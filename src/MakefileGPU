# ---------------------------------------------------------------
# Reconstruction directly from a.his (GPU).  conv.bat is interpreted in
# memory by rhis.c (dark / I0 averaging as img_ave, ren, copy); no
# q????.img is created.  his_main.c reads the angles in output.log and
# runs the 180-degree body (ct_rec / hp_tg) or the 360-degree offset body
# (ofct_rec / ofct_srec); the sources are linked side by side with their
# main() renamed (-DHIS_INPUT), rhis_hp.c once per FOM (rhp.h).
#   his_rec_g_F  : single slice, run beside a.his  (ct_rec_c.c + ofct_rec.c)
#   his_srec_g_F : whole volume, run one level up  (hp_tg_ku.c + ofct_srec.c)
#   his_DO_g     : rotation-axis estimate          (hp2DO.c + ofct_DO.cu)
#   his_tb_rec_g_F, his_tb_srec_g_F : the same with -DHIS_TB, I0 = mean of
#                  all sample views (RHIS_TB in rhis.h)
#   his_srec_g_F_n2i : his_srec with -DHIS_N2I: Noise2Inverse, K interleaved
#                  view subsets reconstructed into rec/0 .. rec/K-1
# ---------------------------------------------------------------
his_g: his_rec_g his_srec_g his_DO_g his_tb_g his_n2i_g
his_rec_g: his_rec_g_r his_rec_g_s his_rec_g_c
his_srec_g: his_srec_g_r his_srec_g_s his_srec_g_c

HIS_REC_SRC = his_main.c ct_rec_c.c ofct_rec.c rhis.c error.c
his_rec_g_r: sort_filter_g.o
	nvcc $(NVCCFLAGS) cbp.cu -DFloat=float -c -DFilter=Ramachandran -o cbp.o
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DHIS_REC -o $(EXE_DIR)/his_rec_g_r $(HIS_REC_SRC) sort_filter_g.o $(SIF_F) $(TIFFLIB) cbp.o $(CUFFT) $(CUDART) -lstdc++ $(LIBS)
his_rec_g_s: sort_filter_g.o
	nvcc $(NVCCFLAGS) cbp.cu -DFloat=float -c -DFilter=Shepp -o cbp.o
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DHIS_REC -o $(EXE_DIR)/his_rec_g_s $(HIS_REC_SRC) sort_filter_g.o $(SIF_F) $(TIFFLIB) cbp.o $(CUFFT) $(CUDART) -lstdc++ $(LIBS)
his_rec_g_c: sort_filter_g.o
	nvcc $(NVCCFLAGS) cbp.cu -DFloat=float -c -DFilter=Chesler -o cbp.o
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DHIS_REC -o $(EXE_DIR)/his_rec_g_c $(HIS_REC_SRC) sort_filter_g.o $(SIF_F) $(TIFFLIB) cbp.o $(CUFFT) $(CUDART) -lstdc++ $(LIBS)

# hp_tg wants FOM=float, ofct_srec FOM=double: compile them and rhis_hp.c
# separately (the float variant of the reader is renamed with _f).
HIS_SREC_OBJS_G = his_hp_tg_g.o his_ofct_srec_g.o his_rhis_hp_f.o his_rhis_hp_d.o
his_hp_tg_g.o: hp_tg_ku.c rhis.h rhp.h cbp.h cbp_pipe.h
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DONLY_CT_VIEWS -DFOM=float -DFloat=float -DRHP_NAME_SUFFIX=_f -c hp_tg_ku.c -o $@
his_ofct_srec_g.o: ofct_srec.c rhis.h rhp.h cbp.h cbp_pipe.h
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DONLY_CT_VIEWS -DFloat=float -c ofct_srec.c -o $@
his_rhis_hp_f.o: rhis_hp.c rhis.h rhp.h blacklim.h
	$(CC) $(CFLAGS) $(OMPF) -DHIS_INPUT -DONLY_CT_VIEWS -DFOM=float -DRHP_NAME_SUFFIX=_f -c rhis_hp.c -o $@
his_rhis_hp_d.o: rhis_hp.c rhis.h rhp.h blacklim.h
	$(CC) $(CFLAGS) $(OMPF) -DHIS_INPUT -DONLY_CT_VIEWS -c rhis_hp.c -o $@
HIS_SREC_SRC = his_main.c rhis.c error.c rl.c
his_srec_g_r: sort_filter_g.o $(HIS_SREC_OBJS_G)
	nvcc $(NVCCFLAGS) cbp.cu -DFloat=float -c -DFilter=Ramachandran -o cbp.o
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DHIS_SREC -o $(EXE_DIR)/his_srec_g_r $(HIS_SREC_SRC) $(HIS_SREC_OBJS_G) sort_filter_g.o $(TIFFLIB) cbp.o $(CUFFT) $(CUDART) -lstdc++ $(LIBS)
his_srec_g_s: sort_filter_g.o $(HIS_SREC_OBJS_G)
	nvcc $(NVCCFLAGS) cbp.cu -DFloat=float -c -DFilter=Shepp -o cbp.o
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DHIS_SREC -o $(EXE_DIR)/his_srec_g_s $(HIS_SREC_SRC) $(HIS_SREC_OBJS_G) sort_filter_g.o $(TIFFLIB) cbp.o $(CUFFT) $(CUDART) -lstdc++ $(LIBS)
his_srec_g_c: sort_filter_g.o $(HIS_SREC_OBJS_G)
	nvcc $(NVCCFLAGS) cbp.cu -DFloat=float -c -DFilter=Chesler -o cbp.o
	$(CC) $(CFLAGS) $(OMPF) -DUSE_GPU -DHIS_INPUT -DHIS_SREC -o $(EXE_DIR)/his_srec_g_c $(HIS_SREC_SRC) $(HIS_SREC_OBJS_G) sort_filter_g.o $(TIFFLIB) cbp.o $(CUFFT) $(CUDART) -lstdc++ $(LIBS)

