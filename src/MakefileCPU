# ct_prj_f_cp.c: img/tif auto-detect + optional Paganin phase retrieval.
# The Paganin filter uses a built-in radix-2 FFT (no external library);
# -fopenmp parallelises it (thread count: PAGANIN_THREADS, default = CPUs).
ct_prj_f:
	$(CC) $(CFLAGS) $(OMPF) -o $(EXE_DIR)/ct_prj_f ct_prj_f_cp.c $(TIFFLIB) $(LIBS)
ct_sub_f:
