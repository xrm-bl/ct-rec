tif_ave:
	$(CC) $(CFLAGS) $(AVXF) -o $(EXE_DIR)/tif_ave tif_ave.c rif_tiff.c $(TIFFLIB) $(LIBS)
# tif_mgf is built with $(MGFFLAGS) on top of $(CFLAGS): -O3 -march=native
# is what lets gcc vectorise the median sorting networks across neighbouring
# pixels (pminub/pmaxub for 8bit, pminuw/pmaxuw for 16bit).
# NEVER add -ffast-math / -Ofast / -fassociative-math here: reassociating the
# gaussian tap sum would change the output.  Remove -march=native when the
# binary has to run on a different machine than the one that builds it.
tif_mgf:
	$(CC) $(CFLAGS) $(MGFFLAGS) $(OMPF) -o $(EXE_DIR)/tif_mgf tif_mgf.c $(TIFFLIB) $(LIBS)
his_ave:
	$(CC) $(CFLAGS) -o $(EXE_DIR)/his_ave his_ave.c sif.c $(LIBS)
q3_ave:
