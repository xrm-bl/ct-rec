# numbered TIFF series -> OME-Zarr v0.4 for Fiji/BigDataViewer.
# Needs c-blosc (with lz4/snappy/zstd/zlib); link it statically on shared
# systems: -l:libblosc.a etc.
tif2zar:
	$(CC) $(CFLAGS) $(OMPF) -o $(EXE_DIR)/tif2zar tif2zar.c -lblosc -lzstd -llz4 -lsnappy -lz $(TIFFLIB) $(LIBS)
